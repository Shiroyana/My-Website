# Copy to .env.local for local development. Never commit real values.

# Public site URL, used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://getcambi.com

# Umami Cloud analytics (free tier). Leave empty to disable analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Salt for hashing visitor IPs in the form rate limiter. Any long random string.
RATE_LIMIT_SALT=
